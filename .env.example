# ==============================================================================
# Trend Finder - Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure with your own credentials.
# NEVER commit your actual .env file or real secrets to version control.
# ==============================================================================

# Server & Runtime Configuration
PORT=3000
NODE_ENV=production
CORS_ORIGIN="*"
APP_URL="http://localhost:3000"

# Admin Authentication Token (founder token for protected endpoints)
ADMIN_TOKEN="your_custom_admin_token_here"

# Google Gemini API Key (for AI audio title extraction & pattern analysis)
GEMINI_API_KEY="your_gemini_api_key_here"

# YouTube Data API v3 Key (required for pulling Shorts from YouTube channels)
YOUTUBE_API_KEY="your_youtube_data_api_v3_key_here"

# YouTube Data API v3 Backup Key (optional failover key if primary quota is exhausted)
YOUTUBE_API_KEY_BACKUP="your_backup_youtube_data_api_key_here"

# Firebase Firestore Configuration
# (Used when deploying to external hosting providers such as Vercel or Railway)
FIREBASE_PROJECT_ID="your_firebase_project_id"
FIREBASE_DATABASE_ID="your_firestore_database_id"
FIREBASE_API_KEY="your_firebase_web_api_key"
FIREBASE_AUTH_DOMAIN="your_firebase_project_id.firebaseapp.com"
FIREBASE_STORAGE_BUCKET="your_firebase_project_id.firebasestorage.app"
FIREBASE_MESSAGING_SENDER_ID="your_firebase_messaging_sender_id"
FIREBASE_APP_ID="your_firebase_app_id"

# Alternatively, pass the entire Firebase configuration object as a single JSON string:
# FIREBASE_CONFIG='{"projectId":"...","apiKey":"...","firestoreDatabaseId":"..."}'
